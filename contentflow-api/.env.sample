
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Azure App Configuration settings, provide either connection string or endpoint
AZURE_APP_CONFIG_CONNECTION_STRING=
AZURE_APP_CONFIG_ENDPOINT=https://<app-config-resource-name>.azconfig.io

# SARSP Case Assistant integration
# Optional: prefer setting SARSP_PIPELINE_ID if you want to pin a specific pipeline document id.
SARSP_PIPELINE_ID=
SARSP_PIPELINE_NAME=SARSP_PIPELINE

# Case document input location (Case ID maps to input/{caseId}/)
SARSP_INPUT_STORAGE_ACCOUNT=
SARSP_INPUT_CONTAINER=farmacia-nueva-renewal
SARSP_INPUT_PREFIX_TEMPLATE=input/{caseId}/

# Pipeline result report lookup
SARSP_RESULTS_STORAGE_ACCOUNT=
SARSP_RESULTS_CONTAINER=farmacia-nueva-renewal
SARSP_RESULTS_BLOB_TEMPLATE=results/{caseId}/results.json
SARSP_RESULTS_PREFIX_TEMPLATE=results/{caseId}/